%% =========================================================================
%% YouTrack Permissions — مخطط علاقات قاعدة البيانات (ERD)
%% Database Entity-Relationship Diagram (Migrations 000001 to 000006)
%% =========================================================================
%% تم تحسين الترتيب والتوزيع البصري لتقليل تقاطع الخطوط وتسهيل القراءة
%% وفق التسلسل الهرمي للكيانات:
%%   المستوى 1: الكيانات الأساسية (Organizations, Users, Roles)
%%   المستوى 2: الحاويات والمشاريع (Groups, Projects)
%%   المستوى 3: جداول الوصل والربط (Group Members, Assigned Roles)
%% =========================================================================

erDiagram

    %% =====================================================================
    %% المستوى 1: الكيانات الأساسية المستقلة (Core Master Entities)
    %% =====================================================================

    organizations {
        varchar     id          PK "مفتاح أساسي (UUID)"
        varchar     key         UK "NOT NULL — مفتاح المؤسسة الفريد"
        varchar     name           "NOT NULL — اسم المؤسسة"
        text        description    "وصف المؤسسة"
        text        icon_url       "رابط الأيقونة"
        timestamptz created_at     "طابع تدقيق داخلي"
        timestamptz updated_at     "طابع تدقيق داخلي"
    }

    users {
        varchar     id                PK "مفتاح أساسي (UUID)"
        varchar     login             UK "NOT NULL — اسم تسجيل الدخول"
        varchar     email                "البريد الإلكتروني"
        varchar     full_name            "الاسم الكامل"
        varchar     name                 "الاسم المعروض/المختصر"
        text        avatar_url           "رابط الصورة الرمزية"
        boolean     banned            "NOT NULL DEFAULT FALSE — محظور"
        boolean     online            "NOT NULL DEFAULT FALSE — متصل حالياً"
        boolean     guest                "حساب ضيف"
        user_type   type                 "AGENT | STANDARD_USER | REPORTER"
        varchar     hub_id               "معرّف Hub"
        varchar     ring_id              "معرّف Ring"
        timestamptz last_login_time      "آخر تسجيل دخول"
        timestamptz creation_time        "وقت الإنشاء في YouTrack"
        timestamptz update_time          "آخر تحديث في YouTrack"
        boolean     is_anonymized     "NOT NULL DEFAULT FALSE — بيانات مجهولة"
        text        ban_reason           "سبب الحظر"
        text        hash_password        "كلمة المرور مشفرة bcrypt"
        timestamptz created_at           "طابع تدقيق داخلي"
        timestamptz updated_at           "طابع تدقيق داخلي"
    }

    roles {
        varchar    id          PK "مفتاح أساسي (معرّف نصي أو UUID)"
        varchar    name        UK "NOT NULL — اسم الدور الفريد"
        text       description    "وصف الدور"
        text_array permissions    "مصفوفة الصلاحيات الممنوحة TEXT[]"
        boolean    immutable   "NOT NULL DEFAULT FALSE — دور نظام ثابت"
    }

    %% =====================================================================
    %% المستوى 2: الحاويات، فرق العمل، والمشاريع (Containers & Projects)
    %% =====================================================================

    groups {
        varchar     id                     PK "مفتاح أساسي (UUID)"
        varchar     name                   UK "NOT NULL — اسم المجموعة أو الفريق"
        text        description               "الوصف المعروض"
        varchar     group_type                "DEFAULT 'GROUP' — GROUP | TEAM"
        varchar     parent_group_id        FK "مرجع ذاتي → groups.id"
        bigint      users_count            "NOT NULL DEFAULT 0 — عدّاد الأعضاء"
        text        icon                      "رابط أيقونة المجموعة"
        boolean     all_users_group        "NOT NULL DEFAULT FALSE — مجموعة الكل"
        boolean     registered_users_group "NOT NULL DEFAULT FALSE — مجموعة المسجلين"
        boolean     auto_join              "NOT NULL DEFAULT FALSE — انضمام تلقائي"
        timestamptz created_at                "DEFAULT NOW() — وقت الإنشاء"
        timestamptz updated_at                "DEFAULT NOW() — وقت التحديث"
    }

    projects {
        varchar     id              PK "مفتاح أساسي (UUID)"
        varchar     name               "NOT NULL — اسم المشروع"
        varchar     short_name      UK "NOT NULL — بادئة معرف التذاكر"
        boolean     archived        "NOT NULL DEFAULT FALSE — مشروع مؤرشف"
        boolean     template        "NOT NULL DEFAULT FALSE — مشروع قالب"
        text        description         "وصف المشروع"
        varchar     organization_id FK "→ organizations.id (SET NULL)"
        varchar     created_by      FK "→ users.id — منشئ المشروع (SET NULL)"
        varchar     leader_id       FK "→ users.id — قائد المشروع (SET NULL)"
        varchar     from_email          "بريد إرسال الإشعارات"
        varchar     reply_to_email      "بريد الرد على الإشعارات"
        text        icon_url            "رابط الأيقونة"
        bigint      starting_number "NOT NULL DEFAULT 1 — رقم بدء التذاكر"
        varchar     team_id         FK "→ groups.id — فريق المشروع (TEAM)"
        timestamptz created_at          "طابع تدقيق داخلي"
        timestamptz updated_at          "طابع تدقيق داخلي"
    }

    %% =====================================================================
    %% المستوى 3: جداول الوصل والربط المتعدد (Junction & Association Tables)
    %% =====================================================================

    group_members {
        varchar     id              PK "مفتاح أساسي (UUID)"
        varchar     group_id        FK "NOT NULL — المجموعة الحاوية (CASCADE)"
        varchar     user_id         FK "عضو مستخدم → users.id (CASCADE)"
        varchar     member_type        "DEFAULT 'USER' — USER | GROUP"
        varchar     member_group_id FK "عضو مجموعة/فريق فرعي (CASCADE)"
        boolean     is_team_member     "DEFAULT FALSE — هل العضو ضمن فريق عمل"
        timestamptz created_at         "DEFAULT NOW() — وقت الإضافة"
    }

    assigned_roles {
        varchar           id              PK "مفتاح أساسي (UUID)"
        varchar           role_id         FK "NOT NULL — → roles.id (CASCADE)"
        access_scope_type scope_type      "NOT NULL — GLOBAL | ORGANIZATION | PROJECT"
        varchar           project_id      FK "→ projects.id (CASCADE) — نطاق المشروع"
        varchar           organization_id FK "→ organizations.id (CASCADE) — نطاق المؤسسة"
        varchar           user_id         FK "→ users.id (CASCADE) — الحامل: مستخدم"
        varchar           group_id        FK "→ groups.id (CASCADE) — الحامل: مجموعة/فريق"
        timestamptz       created_at         "طابع تدقيق داخلي"
        timestamptz       updated_at         "طابع تدقيق داخلي"
    }

    %% =====================================================================
    %% العلاقات (Relationships — مرتبة انسيابياً من الأعلى إلى الأسفل)
    %% =====================================================================

    %% 1. تدرج المجموعات الذاتي (Self-referencing tree)
    groups o|--o{ groups : "parent_group_id — تدرج هرمي"

    %% 2. علاقات سياق المشاريع (Projects Context)
    organizations ||--o{ projects : "organization_id (SET NULL)"
    users         ||--o{ projects : "leader_id — قائد المشروع (SET NULL)"
    users         ||--o{ projects : "created_by — منشئ المشروع (SET NULL)"
    groups        ||--o| projects : "team_id — فريق عمل المشروع (TEAM)"

    %% 3. عضوية المجموعات والفرق (Group Membership)
    groups ||--o{ group_members : "group_id — المجموعة الحاوية"
    users  ||--o{ group_members : "user_id — عضوية حساب مستخدم"
    groups ||--o{ group_members : "member_group_id — عضوية مجموعة فرعية"

    %% 4. إسناد الأدوار والصلاحيات (Role Assignments)
    roles         ||--o{ assigned_roles : "role_id — الدور الممنوح"
    organizations ||--o{ assigned_roles : "organization_id — نطاق المؤسسة"
    projects      ||--o{ assigned_roles : "project_id — نطاق المشروع"
    users         ||--o{ assigned_roles : "user_id — حامل الصلاحية: مستخدم"
    groups        ||--o{ assigned_roles : "group_id — حامل الصلاحية: مجموعة/فريق"