%% ══════════════════════════════════════════════════════════════════════════════════
%% YouTrack Scoped Permissions Matrix: ScopeLevel -> EntityType -> OperationType
%% ══════════════════════════════════════════════════════════════════════════════════
%% هذا المخطط يربط كل مستوى نطاق (Scope) بالموارد المستهدفة (Entities)
%% والعمليات المسموح بها برمجياً (Operations) وفقاً لكتالوج YouTrack ومعياره الرسمي
%% ══════════════════════════════════════════════════════════════════════════════════

graph LR

    %% ─────────────────────────────────────────────────────────────
    %% Level 1: Scope Levels (أفق النطاق)
    %% ─────────────────────────────────────────────────────────────
    ROOT["🏛️ YouTrack Authorization Engine<br/>نظام الصلاحيات متعدد المستويات"]

    SCOPE_G["🌐 ScopeGlobal<br/>النطاق الشامل للخادم<br/>(10 صلاحيات)"]
    SCOPE_O["🏢 ScopeOrganization<br/>نطاق المؤسسة<br/>(3 صلاحيات)"]
    SCOPE_P["📁 ScopeProject<br/>نطاق المشروع<br/>(44 صلاحية)"]

    ROOT --> SCOPE_G
    ROOT --> SCOPE_O
    ROOT --> SCOPE_P

    %% ═════════════════════════════════════════════════════════════
    %% 1. GLOBAL SCOPE BRANCH
    %% ═════════════════════════════════════════════════════════════
    subgraph SG_GLOBAL["🌐 النطاق العام — ScopeGlobal (System-Wide)"]
        %% Entities
        G_ENT_SYS["🎯 EntitySystem<br/>النظام العام"]
        G_ENT_USER["🎯 EntityUser<br/>سجلات المستخدمين"]
        G_ENT_ORG["🎯 EntityOrganization<br/>كيان المؤسسة"]
        G_ENT_PROJ["🎯 EntityProject<br/>كيان المشروع"]

        %% Operations
        G_OPS_SYS["⚡ Operations:<br/>• READ (Low-level Admin Read)<br/>• ADMIN (Low-level Admin Write)"]
        G_OPS_USER["⚡ Operations:<br/>• CREATE (Create User)<br/>• READ (Read Basic & Details)<br/>• UPDATE (Update User & Profile)<br/>• DELETE (Delete User)"]
        G_OPS_ORG["⚡ Operations:<br/>• CREATE (Create Organization)"]
        G_OPS_PROJ["⚡ Operations:<br/>• CREATE (Create Project)"]

        G_ENT_SYS --> G_OPS_SYS
        G_ENT_USER --> G_OPS_USER
        G_ENT_ORG --> G_OPS_ORG
        G_ENT_PROJ --> G_OPS_PROJ
    end

    SCOPE_G --> G_ENT_SYS
    SCOPE_G --> G_ENT_USER
    SCOPE_G --> G_ENT_ORG
    SCOPE_G --> G_ENT_PROJ

    %% ═════════════════════════════════════════════════════════════
    %% 2. ORGANIZATION SCOPE BRANCH
    %% ═════════════════════════════════════════════════════════════
    subgraph SG_ORG["🏢 نطاق المؤسسة — ScopeOrganization (Tenant-Level)"]
        O_ENT_ORG["🎯 EntityOrganization<br/>المؤسسة التابعة"]
        O_OPS_ORG["⚡ Operations:<br/>• READ (Read Organization)<br/>• UPDATE (Update Organization)<br/>• DELETE (Delete Organization)"]

        O_ENT_ORG --> O_OPS_ORG
    end

    SCOPE_O --> O_ENT_ORG

    %% ═════════════════════════════════════════════════════════════
    %% 3. PROJECT SCOPE BRANCH
    %% ═════════════════════════════════════════════════════════════
    subgraph SG_PROJ["📁 نطاق المشروع — ScopeProject (Project-Level)"]
        P_ENT_ISSUE["🎯 EntityIssue<br/>المهام والتذاكر"]
        P_ENT_ATTACH["🎯 EntityAttachment<br/>مرفقات التذاكر"]
        P_ENT_COMMENT["🎯 EntityComment<br/>تعليقات التذاكر"]
        P_ENT_WORK["🎯 EntityWorkItem<br/>تتبع الوقت وساعات العمل"]
        P_ENT_ARTICLE["🎯 EntityArticle<br/>مقالات المعرفة"]
        P_ENT_ARTCOM["🎯 EntityArticleComment<br/>تعليقات المقالات"]
        P_ENT_PROJ["🎯 EntityProject<br/>إدارة المشروع"]
        P_ENT_APP["🎯 EntityApp<br/>أتمتة وسير العمل"]
        P_ENT_WATCH["🎯 EntityWatchFolder<br/>الوسوم والبحث المحفوظ"]

        P_OPS_ISSUE["⚡ Operations:<br/>• CREATE, READ, UPDATE, DELETE<br/>• LINK (Link Issue)<br/>• SPECIAL (Private Fields, Silent Update...)"]
        P_OPS_ATTACH["⚡ Operations:<br/>• CREATE (Add Attachment)<br/>• UPDATE, DELETE (Attachment)"]
        P_OPS_COMMENT["⚡ Operations:<br/>• CREATE, READ, UPDATE, DELETE (Comments)"]
        P_OPS_WORK["⚡ Operations:<br/>• CREATE, READ, UPDATE (Work Items)"]
        P_OPS_ARTICLE["⚡ Operations:<br/>• CREATE, READ, UPDATE, DELETE (Articles)"]
        P_OPS_ARTCOM["⚡ Operations:<br/>• CREATE, READ, UPDATE, DELETE (Article Comments)"]
        P_OPS_PROJ["⚡ Operations:<br/>• READ (Basic & Full)<br/>• UPDATE (Project Settings)"]
        P_OPS_APP["⚡ Operations:<br/>• READ (Read App Content)<br/>• UPDATE (Update App Content)"]
        P_OPS_WATCH["⚡ Operations:<br/>• CREATE, UPDATE, DELETE<br/>• SHARE (Share Custom View)"]

        P_ENT_ISSUE --> P_OPS_ISSUE
        P_ENT_ATTACH --> P_OPS_ATTACH
        P_ENT_COMMENT --> P_OPS_COMMENT
        P_ENT_WORK --> P_OPS_WORK
        P_ENT_ARTICLE --> P_OPS_ARTICLE
        P_ENT_ARTCOM --> P_OPS_ARTCOM
        P_ENT_PROJ --> P_OPS_PROJ
        P_ENT_APP --> P_OPS_APP
        P_ENT_WATCH --> P_OPS_WATCH
    end

    SCOPE_P --> P_ENT_ISSUE
    SCOPE_P --> P_ENT_ATTACH
    SCOPE_P --> P_ENT_COMMENT
    SCOPE_P --> P_ENT_WORK
    SCOPE_P --> P_ENT_ARTICLE
    SCOPE_P --> P_ENT_ARTCOM
    SCOPE_P --> P_ENT_PROJ
    SCOPE_P --> P_ENT_APP
    SCOPE_P --> P_ENT_WATCH

    %% ─────────────────────────────────────────────────────────────
    %% Styling and Classes
    %% ─────────────────────────────────────────────────────────────
    classDef rootNode fill:#0f172a,stroke:#334155,stroke-width:2px,color:#f8fafc,font-weight:bold
    classDef scopeNode fill:#1e40af,stroke:#1d4ed8,stroke-width:2px,color:#fff,font-weight:bold
    classDef entityNode fill:#0f766e,stroke:#0d9488,stroke-width:1.5px,color:#fff
    classDef opNode fill:#92400e,stroke:#b45309,stroke-width:1px,color:#fff

    class ROOT rootNode
    class SCOPE_G,SCOPE_O,SCOPE_P scopeNode
    class G_ENT_SYS,G_ENT_USER,G_ENT_ORG,G_ENT_PROJ,O_ENT_ORG,P_ENT_ISSUE,P_ENT_ATTACH,P_ENT_COMMENT,P_ENT_WORK,P_ENT_ARTICLE,P_ENT_ARTCOM,P_ENT_PROJ,P_ENT_APP,P_ENT_WATCH entityNode
    class G_OPS_SYS,G_OPS_USER,G_OPS_ORG,G_OPS_PROJ,O_OPS_ORG,P_OPS_ISSUE,P_OPS_ATTACH,P_OPS_COMMENT,P_OPS_WORK,P_OPS_ARTICLE,P_OPS_ARTCOM,P_OPS_PROJ,P_OPS_APP,P_OPS_WATCH opNode
