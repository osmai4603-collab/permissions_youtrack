%% ══════════════════════════════════════════════════════════════════════
%% YouTrack Permissions — Four Dimensions Architecture
%% ══════════════════════════════════════════════════════════════════════
%% تعريف الصلاحية الكامل = ScopeLevel × ModuleType × EntityType × OperationType
%% ══════════════════════════════════════════════════════════════════════

graph TB

    %% ─────────────────────────────────────────────
    %% Central Permission Node
    %% ─────────────────────────────────────────────
    PERM["🔐 Permission<br/>تعريف الصلاحية الكامل<br/>━━━━━━━━━━━━━━━━━━<br/>ID · DisplayName · Description<br/>IsGlobal · ImpliedPerms · DependentPerms"]

    %% ═══════════════════════════════════════════════════════
    %% Dimension 1: ScopeLevel — أين تسري الصلاحية؟
    %% ═══════════════════════════════════════════════════════
    SCOPE["🌍 البُعد الأول<br/>ScopeLevel<br/>أين تسري الصلاحية؟"]

    SCOPE_GLOBAL["🌐 GLOBAL<br/>مستوى الخادم الكامل<br/>━━━━━━━━━━━━━━━━━━<br/>تسري على جميع المؤسسات<br/>والمشاريع بلا استثناء"]
    SCOPE_ORG["🏢 ORGANIZATION<br/>مستوى المؤسسة<br/>━━━━━━━━━━━━━━━━━━<br/>تسري داخل مؤسسة محددة<br/>وتشمل مشاريعها"]
    SCOPE_PROJ["📁 PROJECT<br/>مستوى المشروع<br/>━━━━━━━━━━━━━━━━━━<br/>تسري داخل مشروع<br/>واحد فقط"]

    PERM -->|"أين؟"| SCOPE
    SCOPE --> SCOPE_GLOBAL
    SCOPE --> SCOPE_ORG
    SCOPE --> SCOPE_PROJ

    %% Scope Hierarchy (Cascading)
    SCOPE_GLOBAL -.->|"يتضمن ⬇"| SCOPE_ORG
    SCOPE_ORG -.->|"يتضمن ⬇"| SCOPE_PROJ

    %% ═══════════════════════════════════════════════════════
    %% Dimension 2: ModuleType — في أي نطاق وظيفي؟
    %% ═══════════════════════════════════════════════════════
    MODULE["⚙️ البُعد الثاني<br/>ModuleType<br/>في أي نطاق وظيفي؟"]

    MOD_SYS["🖥️ SYSTEM<br/>إدارة النظام"]
    MOD_APP["📱 APP<br/>التطبيقات"]
    MOD_ARTICLE["📝 ARTICLE<br/>المقالات"]
    MOD_ARTCOM["💬 ARTICLE_COMMENT<br/>تعليقات المقالات"]
    MOD_ISSUE["🎫 ISSUE<br/>المهام"]
    MOD_ATTACH["📎 ISSUE_ATTACHMENT<br/>مرفقات المهام"]
    MOD_ISSCOM["🗨️ ISSUE_COMMENT<br/>تعليقات المهام"]
    MOD_WORK["⏱️ ISSUE_WORK_ITEM<br/>عناصر العمل"]
    MOD_ORG["🏛️ ORGANIZATION<br/>المؤسسات"]
    MOD_PROJ["📂 PROJECT<br/>المشاريع"]
    MOD_USER["👤 USER<br/>المستخدمون"]
    MOD_WATCH["👁️ WATCH_FOLDER<br/>مجلدات المراقبة"]

    PERM -->|"أي وحدة؟"| MODULE
    MODULE --> MOD_SYS
    MODULE --> MOD_APP
    MODULE --> MOD_ARTICLE
    MODULE --> MOD_ARTCOM
    MODULE --> MOD_ISSUE
    MODULE --> MOD_ATTACH
    MODULE --> MOD_ISSCOM
    MODULE --> MOD_WORK
    MODULE --> MOD_ORG
    MODULE --> MOD_PROJ
    MODULE --> MOD_USER
    MODULE --> MOD_WATCH

    %% ═══════════════════════════════════════════════════════
    %% Dimension 3: EntityType — على أي مورد؟
    %% ═══════════════════════════════════════════════════════
    ENTITY["🎯 البُعد الثالث<br/>EntityType<br/>على أي مورد؟"]

    ENT_SYS["🖥️ SYSTEM<br/>النظام"]
    ENT_APP["📱 APP<br/>التطبيق"]
    ENT_ARTICLE["📝 ARTICLE<br/>المقال"]
    ENT_ARTCOM["💬 ARTICLE_COMMENT<br/>تعليق المقال"]
    ENT_ISSUE["🎫 ISSUE<br/>المهمة"]
    ENT_ATTACH["📎 ATTACHMENT<br/>المرفق"]
    ENT_COMMENT["🗨️ COMMENT<br/>التعليق"]
    ENT_WORK["⏱️ WORK_ITEM<br/>عنصر العمل"]
    ENT_ORG["🏛️ ORGANIZATION<br/>المؤسسة"]
    ENT_PROJ["📂 PROJECT<br/>المشروع"]
    ENT_USER["👤 USER<br/>المستخدم"]
    ENT_WATCH["👁️ WATCH_FOLDER<br/>مجلد المراقبة"]

    PERM -->|"أي مورد؟"| ENTITY
    ENTITY --> ENT_SYS
    ENTITY --> ENT_APP
    ENTITY --> ENT_ARTICLE
    ENTITY --> ENT_ARTCOM
    ENTITY --> ENT_ISSUE
    ENTITY --> ENT_ATTACH
    ENTITY --> ENT_COMMENT
    ENTITY --> ENT_WORK
    ENTITY --> ENT_ORG
    ENTITY --> ENT_PROJ
    ENTITY --> ENT_USER
    ENTITY --> ENT_WATCH

    %% ═══════════════════════════════════════════════════════
    %% Dimension 4: OperationType — ما هو الإجراء المسموح؟
    %% ═══════════════════════════════════════════════════════
    OPERATION["⚡ البُعد الرابع<br/>OperationType<br/>ما هو الإجراء المسموح؟"]

    OP_CREATE["➕ CREATE<br/>إنشاء"]
    OP_READ["👁️ READ<br/>قراءة"]
    OP_UPDATE["✏️ UPDATE<br/>تعديل"]
    OP_DELETE["🗑️ DELETE<br/>حذف"]
    OP_LINK["🔗 LINK<br/>ربط"]
    OP_SHARE["🤝 SHARE<br/>مشاركة"]
    OP_ADMIN["🛡️ ADMIN<br/>إدارة"]
    OP_SPECIAL["⭐ SPECIAL<br/>خاص"]

    PERM -->|"أي إجراء؟"| OPERATION
    OPERATION --> OP_CREATE
    OPERATION --> OP_READ
    OPERATION --> OP_UPDATE
    OPERATION --> OP_DELETE
    OPERATION --> OP_LINK
    OPERATION --> OP_SHARE
    OPERATION --> OP_ADMIN
    OPERATION --> OP_SPECIAL

    %% ═══════════════════════════════════════════════════════
    %% CRUD Grouping
    %% ═══════════════════════════════════════════════════════
    subgraph CRUD["عمليات CRUD الأساسية"]
        OP_CREATE
        OP_READ
        OP_UPDATE
        OP_DELETE
    end

    subgraph EXTENDED["عمليات مُوسَّعة"]
        OP_LINK
        OP_SHARE
        OP_ADMIN
        OP_SPECIAL
    end

    %% ═══════════════════════════════════════════════════════
    %% Example: Complete Permission Definition
    %% ═══════════════════════════════════════════════════════
    EXAMPLE["📋 مثال: تحديد صلاحية كاملة<br/>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━<br/>ID: read-issue<br/>Scope: PROJECT 📁<br/>Module: ISSUE 🎫<br/>Entity: ISSUE 🎫<br/>Operation: READ 👁️<br/>━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━<br/>المعنى: قراءة المهام داخل مشروع محدد"]

    SCOPE_PROJ -.->|"مثال"| EXAMPLE
    MOD_ISSUE -.->|"مثال"| EXAMPLE
    ENT_ISSUE -.->|"مثال"| EXAMPLE
    OP_READ -.->|"مثال"| EXAMPLE

    %% ═══════════════════════════════════════════════════════
    %% Styling
    %% ═══════════════════════════════════════════════════════
    classDef center fill:#1a1a2e,stroke:#e94560,stroke-width:3px,color:#eee,font-size:14px
    classDef dimTitle fill:#16213e,stroke:#0f3460,stroke-width:2px,color:#e2e2e2,font-size:13px
    classDef scopeNode fill:#0d7377,stroke:#14ffec,stroke-width:1px,color:#fff,font-size:11px
    classDef moduleNode fill:#533483,stroke:#a855f7,stroke-width:1px,color:#fff,font-size:11px
    classDef entityNode fill:#2d4059,stroke:#60a5fa,stroke-width:1px,color:#fff,font-size:11px
    classDef operationNode fill:#b91c1c,stroke:#f87171,stroke-width:1px,color:#fff,font-size:11px
    classDef exampleNode fill:#065f46,stroke:#34d399,stroke-width:2px,color:#fff,font-size:11px
    classDef crudGroup fill:transparent,stroke:#f87171,stroke-width:1px,stroke-dasharray:5 5,color:#fca5a5
    classDef extGroup fill:transparent,stroke:#fbbf24,stroke-width:1px,stroke-dasharray:5 5,color:#fcd34d

    class PERM center
    class SCOPE,MODULE,ENTITY,OPERATION dimTitle

    class SCOPE_GLOBAL,SCOPE_ORG,SCOPE_PROJ scopeNode
    class MOD_SYS,MOD_APP,MOD_ARTICLE,MOD_ARTCOM,MOD_ISSUE,MOD_ATTACH,MOD_ISSCOM,MOD_WORK,MOD_ORG,MOD_PROJ,MOD_USER,MOD_WATCH moduleNode
    class ENT_SYS,ENT_APP,ENT_ARTICLE,ENT_ARTCOM,ENT_ISSUE,ENT_ATTACH,ENT_COMMENT,ENT_WORK,ENT_ORG,ENT_PROJ,ENT_USER,ENT_WATCH entityNode
    class OP_CREATE,OP_READ,OP_UPDATE,OP_DELETE,OP_LINK,OP_SHARE,OP_ADMIN,OP_SPECIAL operationNode
    class EXAMPLE exampleNode
    class CRUD crudGroup
    class EXTENDED extGroup
