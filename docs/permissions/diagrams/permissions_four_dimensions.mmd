%% ══════════════════════════════════════════════════════════════════════
%% YouTrack Permissions — Three Dimensions Architecture
%% ══════════════════════════════════════════════════════════════════════
%% تعريف الصلاحية الكامل الرسمي = ScopeLevel × EntityType × OperationType
%% ══════════════════════════════════════════════════════════════════════

graph TB

    %% ─────────────────────────────────────────────
    %% Central Permission Node
    %% ─────────────────────────────────────────────
    PERM["🔐 Permission<br/>تعريف الصلاحية الكامل (YouTrack Official)<br/>━━━━━━━━━━━━━━━━━━<br/>ID · DisplayName · Description<br/>IsGlobal · ImpliedPerms · DependentPerms"]

    %% ═══════════════════════════════════════════════════════
    %% Dimension 1: ScopeLevel — أين تسري الصلاحية؟
    %% ═══════════════════════════════════════════════════════
    SCOPE["🌍 البُعد الأول<br/>ScopeLevel<br/>أين تسري الصلاحية؟"]

    SCOPE_GLOBAL["🌐 GLOBAL<br/>مستوى الخادم الكامل<br/>━━━━━━━━━━━━━━━━━━<br/>تسري على جميع المؤسسات<br/>والمشاريع بلا استثناء"]
    SCOPE_ORG["🏢 ORGANIZATION<br/>مستوى المؤسسة<br/>━━━━━━━━━━━━━━━━━━<br/>تسري داخل مؤسسة محددة<br/>وتشمل مشاريعها"]
    SCOPE_PROJ["📁 PROJECT<br/>مستوى المشروع<br/>━━━━━━━━━━━━━━━━━━<br/>تسري داخل مشروع<br/>واحد فقط"]

    PERM -->|"أين؟"| SCOPE
    SCOPE --> SCOPE_GLOBAL
    SCOPE --> SCOPE_ORG
    SCOPE --> SCOPE_PROJ

    %% Scope Hierarchy (Cascading)
    SCOPE_GLOBAL -.->|"يتضمن ⬇"| SCOPE_ORG
    SCOPE_ORG -.->|"يتضمن ⬇"| SCOPE_PROJ

    %% ═══════════════════════════════════════════════════════
    %% Dimension 2: EntityType — على أي مورد؟
    %% ═══════════════════════════════════════════════════════
    ENTITY["🎯 البُعد الثاني<br/>EntityType<br/>على أي مورد؟"]

    ENT_SYS["🖥️ SYSTEM<br/>النظام والخادم"]
    ENT_APP["📱 APP<br/>التطبيقات وسير العمل"]
    ENT_ARTICLE["📝 ARTICLE<br/>مقالات المعرفة"]
    ENT_ARTCOM["💬 ARTICLE_COMMENT<br/>تعليقات المقالات"]
    ENT_ISSUE["🎫 ISSUE<br/>المهام والتذاكر"]
    ENT_ATTACH["📎 ATTACHMENT<br/>المرفقات"]
    ENT_COMMENT["🗨️ COMMENT<br/>التعليقات"]
    ENT_WORK["⏱️ WORK_ITEM<br/>عناصر وسجلات العمل"]
    ENT_ORG["🏛️ ORGANIZATION<br/>المؤسسات"]
    ENT_PROJ["📂 PROJECT<br/>المشاريع"]
    ENT_USER["👤 USER<br/>المستخدمون"]
    ENT_WATCH["👁️ WATCH_FOLDER<br/>مجلدات المراقبة والوسوم"]

    PERM -->|"على أي مورد؟"| ENTITY
    ENTITY --> ENT_SYS
    ENTITY --> ENT_APP
    ENTITY --> ENT_ARTICLE
    ENTITY --> ENT_ARTCOM
    ENTITY --> ENT_ISSUE
    ENTITY --> ENT_ATTACH
    ENTITY --> ENT_COMMENT
    ENTITY --> ENT_WORK
    ENTITY --> ENT_ORG
    ENTITY --> ENT_PROJ
    ENTITY --> ENT_USER
    ENTITY --> ENT_WATCH

    %% ═══════════════════════════════════════════════════════
    %% Dimension 3: OperationType — ما هو الإجراء؟
    %% ═══════════════════════════════════════════════════════
    OPERATION["⚡ البُعد الثالث<br/>OperationType<br/>ما هو الإجراء؟"]

    OP_CREATE["➕ CREATE<br/>إنشاء مورد جديد"]
    OP_READ["👁️ READ<br/>قراءة وعرض"]
    OP_UPDATE["✏️ UPDATE<br/>تعديل وتحديث"]
    OP_DELETE["🗑️ DELETE<br/>حذف المورد"]
    OP_LINK["🔗 LINK<br/>ربط التذاكر"]
    OP_SHARE["👥 SHARE<br/>مشاركة العروض"]
    OP_ADMIN["⚙️ ADMIN<br/>إدارة متقدمة"]
    OP_SPECIAL["🌟 SPECIAL<br/>إجراءات خاصة"]

    PERM -->|"ما هو الإجراء؟"| OPERATION
    OPERATION --> OP_CREATE
    OPERATION --> OP_READ
    OPERATION --> OP_UPDATE
    OPERATION --> OP_DELETE
    OPERATION --> OP_LINK
    OPERATION --> OP_SHARE
    OPERATION --> OP_ADMIN
    OPERATION --> OP_SPECIAL

    %% ─────────────────────────────────────────────
    %% Styling and Classes
    %% ─────────────────────────────────────────────
    classDef permNode fill:#7c3aed,stroke:#5b21b6,stroke-width:3px,color:#fff,font-weight:bold
    classDef dimNode fill:#1e293b,stroke:#475569,stroke-width:2px,color:#f8fafc,font-weight:bold
    classDef scopeNode fill:#0284c7,stroke:#0369a1,stroke-width:1.5px,color:#fff
    classDef entityNode fill:#0d9488,stroke:#0f766e,stroke-width:1.5px,color:#fff
    classDef opNode fill:#d97706,stroke:#b45309,stroke-width:1.5px,color:#fff

    class PERM permNode
    class SCOPE,ENTITY,OPERATION dimNode
    class SCOPE_GLOBAL,SCOPE_ORG,SCOPE_PROJ scopeNode
    class ENT_SYS,ENT_APP,ENT_ARTICLE,ENT_ARTCOM,ENT_ISSUE,ENT_ATTACH,ENT_COMMENT,ENT_WORK,ENT_ORG,ENT_PROJ,ENT_USER,ENT_WATCH entityNode
    class OP_CREATE,OP_READ,OP_UPDATE,OP_DELETE,OP_LINK,OP_SHARE,OP_ADMIN,OP_SPECIAL opNode
